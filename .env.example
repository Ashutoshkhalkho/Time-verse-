# ==============================================================================
# TIMEWISE Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment.
# NEVER commit the real .env file with production secrets.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME=TIMEWISE
DEBUG=true
API_V1_STR=/api/v1

# Security & Authentication
# Generate a secure 64-character secret using: openssl rand -hex 32
SECRET_KEY=change-this-insecure-secret-key-for-development-only-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 16+)
# For local development with Docker Compose:
# postgresql+asyncpg://timewise_user:timewise_password@localhost:5432/timewise_db
# For SQLite test fallback:
# sqlite+aiosqlite:///./timewise_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timewise_dev
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/timewise_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0
ALERT_DEDUPLICATION_WINDOW_SECONDS=300

# Optimizer & Scheduling Configuration
SOLVER_TIMEOUT_SECONDS=60
SOLVER_MAX_SEARCH_WORKERS=8

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Institutional Defaults (Configurable Development Defaults)
DEFAULT_PERIOD_DURATION_MINUTES=50
DEFAULT_PERIODS_PER_DAY=7
DEFAULT_MAX_FACULTY_CONSECUTIVE_HOURS=3
DEFAULT_MAX_FACULTY_DAILY_LOAD=5
