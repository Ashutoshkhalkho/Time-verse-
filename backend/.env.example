# TIMEWISE Backend Environment Variables (.env.example)
ENVIRONMENT=development
APP_NAME=TIMEWISE
DEBUG=true
API_V1_STR=/api/v1

SECRET_KEY=change-this-insecure-secret-key-for-development-only-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL URL (for asyncpg: postgresql+asyncpg://user:pass@host:5432/dbname)
# For local SQLite development/testing: sqlite+aiosqlite:///./timewise_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timewise_dev
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/timewise_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://localhost:6379/0
ALERT_DEDUPLICATION_WINDOW_SECONDS=300

SOLVER_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=json
